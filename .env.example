# ============================================================
#  DRRO — .env.example
#  Copy this file to .env and fill in your real values.
#  This file IS safe to commit — it contains NO real secrets.
# ============================================================

# ----- Server -----
SERVER_PORT=8080

# ----- Database (Supabase PostgreSQL) -----
DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# ----- JPA -----
# Options: validate | update | create | none
JPA_DDL_AUTO=validate

# ----- Connection Pool -----
DB_POOL_MAX=10
DB_POOL_MIN=2

# ----- JWT -----
# Generate with: openssl rand -hex 64
JWT_SECRET=your_256bit_secret_key_here
JWT_EXPIRATION_MS=86400000

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Logging -----
LOG_LEVEL=INFO

# ----- Frontend (Vite React) -----
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_NAME=DRRO
VITE_APP_VERSION=1.0.0
